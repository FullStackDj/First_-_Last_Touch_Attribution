<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_first_last_touch" model="ir.ui.view">
        <field name="name">crm.lead.form.first.last.touch</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    string="Attribution"
                    name="first_last_touch_attribution"
                    groups="sales_team.group_sale_salesman"
                    invisible="not flt_first_touch_data and not flt_latest_touch_data">
                    <field name="flt_first_touch_data" invisible="1"/>
                    <field name="flt_latest_touch_data" invisible="1"/>
                    <group>
                        <group string="First Touch">
                            <field name="flt_first_touch_at"/>
                            <field name="flt_first_source"/>
                            <field name="flt_first_medium"/>
                            <field name="flt_first_campaign"/>
                            <field name="flt_first_term"/>
                            <field name="flt_first_content"/>
                            <field name="flt_first_click_id_type"/>
                            <field name="flt_first_click_id"/>
                            <field name="flt_first_landing_path"/>
                            <field name="flt_first_referrer" widget="url"/>
                        </group>
                        <group string="Latest Qualified Acquisition">
                            <field name="flt_latest_touch_at"/>
                            <field name="flt_latest_source"/>
                            <field name="flt_latest_medium"/>
                            <field name="flt_latest_campaign"/>
                            <field name="flt_latest_term"/>
                            <field name="flt_latest_content"/>
                            <field name="flt_latest_click_id_type"/>
                            <field name="flt_latest_click_id"/>
                            <field name="flt_latest_landing_path"/>
                            <field name="flt_latest_referrer" widget="url"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="crm_case_tree_view_leads_first_last_touch" model="ir.ui.view">
        <field name="name">crm.lead.list.lead.first.last.touch</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <field name="source_id" position="after">
                <field name="flt_first_source" optional="hide"/>
                <field name="flt_latest_source" optional="show"/>
                <field name="flt_latest_campaign" optional="hide"/>
                <field name="flt_latest_touch_at" optional="hide"/>
                <field name="flt_latest_click_id_type" optional="hide"/>
                <field name="flt_latest_click_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="crm_case_tree_view_oppor_first_last_touch" model="ir.ui.view">
        <field name="name">crm.lead.list.opportunity.first.last.touch</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <field name="source_id" position="after">
                <field name="flt_first_source" optional="hide"/>
                <field name="flt_latest_source" optional="show"/>
                <field name="flt_latest_campaign" optional="hide"/>
                <field name="flt_latest_touch_at" optional="hide"/>
                <field name="flt_latest_click_id_type" optional="hide"/>
                <field name="flt_latest_click_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_crm_case_leads_filter_first_last_touch" model="ir.ui.view">
        <field name="name">crm.lead.search.lead.first.last.touch</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <field name="campaign_id" position="after">
                <field name="flt_first_source"/>
                <field name="flt_latest_source"/>
                <field name="flt_latest_campaign"/>
                <field name="flt_latest_click_id"/>
                <separator/>
                <filter string="Attributed" name="has_first_touch" domain="[('flt_first_touch_at', '!=', False)]"/>
                <filter string="Has Ad Click ID" name="has_ad_click_id" domain="[('flt_has_ad_click_id', '=', True)]"/>
            </field>
            <xpath expr="//search/group" position="inside">
                <filter string="First Source" name="group_by_flt_first_source"
                        context="{'group_by': 'flt_first_source'}"/>
                <filter string="Latest Source" name="group_by_flt_latest_source"
                        context="{'group_by': 'flt_latest_source'}"/>
                <filter string="Latest Campaign" name="group_by_flt_latest_campaign"
                        context="{'group_by': 'flt_latest_campaign'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_crm_case_opportunities_filter_first_last_touch" model="ir.ui.view">
        <field name="name">crm.lead.search.opportunity.first.last.touch</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <field name="stage_id" position="after">
                <field name="flt_first_source"/>
                <field name="flt_latest_source"/>
                <field name="flt_latest_campaign"/>
                <field name="flt_latest_click_id"/>
                <separator/>
                <filter string="Attributed" name="has_first_touch" domain="[('flt_first_touch_at', '!=', False)]"/>
                <filter string="Has Ad Click ID" name="has_ad_click_id" domain="[('flt_has_ad_click_id', '=', True)]"/>
            </field>
            <xpath expr="//search/group" position="inside">
                <filter string="First Source" name="group_by_flt_first_source"
                        context="{'group_by': 'flt_first_source'}"/>
                <filter string="Latest Source" name="group_by_flt_latest_source"
                        context="{'group_by': 'flt_latest_source'}"/>
                <filter string="Latest Campaign" name="group_by_flt_latest_campaign"
                        context="{'group_by': 'flt_latest_campaign'}"/>
            </xpath>
        </field>
    </record>
</odoo>
